{
  "schema": "camelid.chat_template_shape_pack/v1",
  "pack_id": "phi4-mini-chat-template-shapes-v1",
  "purpose": "Locks the ordinary-message branch of the exact Phi-4-mini-instruct Q8_0 GGUF chat template. Tool-bearing requests fail closed until their metadata-Jinja path is independently validated.",
  "oracle": {
    "engine": "llama.cpp llama-server /apply-template and /tokenize",
