{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://camelid.ai/schemas/benchmark/agent-attempt-v1.schema.json",
  "title": "Camelid agent benchmark attempt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "campaign_id",
    "task_id",
    "adapter",
    "attempt",
    "comparability",
    "terminal",
    "score",
    "usage",
    "timing",
    "process"
  ],
  "properties": {
    "schema": { "const": "camelid.benchmark.agent-attempt/v1" },
    "campaign_id": { "$ref": "#/$defs/id" },
    "task_id": { "$ref": "#/$defs/id" },
    "adapter": { "enum": ["camelid-native", "pi"] },
    "attempt": { "type": "integer", "minimum": 0 },
    "comparability": { "enum": ["comparable", "noncomparable"] },
    "terminal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "exit_code", "reason"],
      "properties": {
        "class": { "enum": ["answered", "failed", "inconclusive", "timed_out", "cancelled", "adapter_error"] },
        "exit_code": { "type": ["integer", "null"] },
        "reason": { "$ref": "#/$defs/non_empty" }
      }
    },
    "score": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "required_checks", "passed_checks", "diff_sha256"],
      "properties": {
        "outcome": {
          "enum": [
            "PASS_COMPARABLE",
            "PASS_NONCOMPARABLE",
            "FAIL_BEHAVIOR",
            "FAIL_FORBIDDEN_MUTATION",
            "FAIL_AGENT_TERMINAL",
            "INCONCLUSIVE_TIMEOUT",
            "INCONCLUSIVE_STEP_CAP",
            "INVALID_FIXTURE",
            "INVALID_SCORER",
            "INVALID_INFRASTRUCTURE"
          ]
        },
        "required_checks": { "type": "integer", "minimum": 1 },
        "passed_checks": { "type": "integer", "minimum": 0 },
        "diff_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_steps", "tool_calls", "input_tokens", "output_tokens", "unavailable_reason"],
      "properties": {
        "model_steps": { "$ref": "#/$defs/nullable_non_negative_integer" },
        "tool_calls": { "$ref": "#/$defs/nullable_non_negative_integer" },
        "input_tokens": { "$ref": "#/$defs/nullable_non_negative_integer" },
        "output_tokens": { "$ref": "#/$defs/nullable_non_negative_integer" },
        "unavailable_reason": { "type": ["string", "null"] }
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wall_ms", "model_ms", "ttft_ms"],
      "properties": {
        "wall_ms": { "$ref": "#/$defs/non_negative_number" },
        "model_ms": { "$ref": "#/$defs/nullable_non_negative_number" },
        "ttft_ms": { "$ref": "#/$defs/nullable_non_negative_number" }
      }
    },
    "process": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cleanup_passed"],
      "properties": {
        "cleanup_passed": { "type": "boolean" }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "non_empty": { "type": "string", "minLength": 1 },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "non_negative_number": { "type": "number", "minimum": 0 },
    "nullable_non_negative_number": {
      "oneOf": [
        { "$ref": "#/$defs/non_negative_number" },
        { "type": "null" }
      ]
    },
    "nullable_non_negative_integer": {
      "oneOf": [
        { "type": "integer", "minimum": 0 },
        { "type": "null" }
      ]
    }
  }
}