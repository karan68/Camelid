{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://camelid.ai/schemas/benchmark/task-check-v1.schema.json",
  "title": "Camelid controller-owned task check v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "passed", "checks"],
  "properties": {
    "schema": { "const": "camelid.benchmark.task-check/v1" },
    "passed": { "type": "boolean" },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "passed", "detail"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "passed": { "type": "boolean" },
          "detail": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    }
  }
}