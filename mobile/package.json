    "@expo-google-fonts/ibm-plex-sans": "^0.4.1",
    "@expo-google-fonts/newsreader": "^0.4.1",
    "@expo/ui": "~57.0.7",
    "expo": "~57.0.8",
    "expo-camera": "~57.0.3",
    "expo-constants": "~57.0.7",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.9",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-glass-effect": "~57.0.1",
    "expo-image": "~57.0.1",
    "expo-linking": "~57.0.4",
    "expo-local-authentication": "~57.0.2",
    "expo-router": "~57.0.8",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.1",
    "expo-system-ui": "~57.0.1",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.0"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/node": "^24.0.0",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.0",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "verify:native": "node scripts/verify-native-artifacts.mjs"
  },
  "jest": {
    "preset": "jest-expo",
    "testRegex": ".*(?:-test|\\.test)\\.[jt]sx?$",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/android/",
      "/ios/"
    ]
  },
  "overrides": {
    "test-exclude": {
      "brace-expansion": "5.0.8"
    },
    "xcode": {
      "uuid": "11.1.1"
    }
  },
  "private": true
}
