{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://camelid.invalid/schema/remote/v1/event.schema.json",
  "type": "object",
  "required": ["sequence", "event_id", "turn_id", "event", "created_at_unix_ms", "payload"],
  "properties": {
    "sequence": { "type": "integer", "minimum": 1 },
    "event_id": { "type": "string", "format": "uuid" },
    "turn_id": {
      "oneOf": [
        { "type": "string", "format": "uuid" },
        { "type": "null" }
      ]
    },
    "event": { "type": "string", "pattern": "^[a-z0-9_.-]{1,64}$" },
    "created_at_unix_ms": { "type": "integer", "minimum": 0 },
    "payload": { "type": "object" }
  },
  "additionalProperties": false
}